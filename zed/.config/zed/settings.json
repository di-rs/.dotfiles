// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "show_edit_predictions": false,
  "debugger": {
    "button": true
  },
  "status_bar": {
    "show_active_file": false
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "max_output_tokens": 128,
      "prompt_format": "qwen",
      "model": "qwen2.5-coder-3b",
      "api_url": "http://localhost:1234/v1/completions"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "terminal": {
    "toolbar": {
      "breadcrumbs": false
    },
    "keep_selection_on_copy": false,
    "copy_on_select": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show": false
  },
  "title_bar": {
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_worktree_name": false
  },
  "preview_tabs": {
    "enabled": true
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "search": {
    "button": false
  },
  "disable_ai": false,
  "project_panel": {
    "button": true,
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "agent": {
    "default_profile": "write",
    "threads_sidebar": {
      "position": "right"
    },
    "default_model": {
      "effort": "high",
      "provider": "x_ai_subscribed",
      "model": "grok-4.7",
      "enable_thinking": true
    },
    "button": false,
    "dock": "left",
    "favorite_models": [
      {
        "provider": "x_ai_subscribed",
        "model": "grok-4.7",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "x_ai_subscribed",
        "model": "grok-4.6",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "model_parameters": []
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right"
  },
  "helix_mode": true,
  "icon_theme": "Zed (Default)",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "vim_mode": false,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    },
    "steel-language-server": {
      "binary": {
        "path": "steel-language-server"
      }
    }
  }
}
